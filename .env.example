# Copia este archivo a ".env" y rellena tus valores. NUNCA subas ".env" a un repositorio publico.

# Fase de migracion (ver IMPLEMENTACION.md): mock/paper -> live/paper -> live/live
DATA_MODE=mock
EXECUTION_MODE=paper

# Solo necesarios cuando EXECUTION_MODE=live. Crea la key con permiso SOLO de trading,
# nunca actives el permiso de retiro de fondos.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Opcional pero muy recomendado: alertas por Telegram (habla con @BotFather para el token,
# y con @userinfobot para tu chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
